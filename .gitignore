# Terraform. NOTE: .terraform.lock.hcl is deliberately NOT ignored - it pins exact
# provider versions, and a golden fixture that resolves to a different provider build
# on a different machine is not a deterministic fixture (CLAUDE.md §23).
.terraform/
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json

# Go
/bin/
/dist/
*.test
*.out

# SQLite (session/version/finding store, per ADR-002)
*.db
*.db-wal
*.db-shm

.DS_Store

# AWS icon package zip placed in ui/ (licence: canvas/public/aws-icons/ICONS-LICENSE.md) — only the used subset is committed
ui/*.zip

# PC-121: licensed source standards, read locally to build the control mappings. Never committed.
/docs/PCI-DSS-*.pdf
/docs/Trust-services-criteria*.pdf

# Terraform working files (PC-25 Rung 3): state and provider binaries never belong in git.
/validate/rung3/terraform/.terraform/
/validate/rung3/terraform/*.tfstate*
/validate/rung3/terraform/*.tfplan
