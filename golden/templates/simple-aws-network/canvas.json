    {
      "id": "aws_internet_gateway.simple",
      "type": "network_boundary",
      "label": "simple internet gateway",
      "capability": {},
      "service_id": "aws_internet_gateway"
    },
    {
      "id": "aws_route_table.simple_public",
      "type": "network_boundary",
      "label": "Public · internet access",
      "capability": {
        "design_local_route": "10.20.0.0/16 -> local (AWS-created)"
      },
      "service_id": "aws_route_table",
      "routes": [
        {
          "destination_cidr": "0.0.0.0/0",
          "target": "aws_internet_gateway.simple"
        }
      ]
    },
    {
      "id": "aws_nat_gateway.simple_a",
      "type": "network_boundary",
      "label": "simple NAT A",
      "capability": {
        "connectivity_type": "public",
        "design_elastic_ip": "Allocate an Elastic IP at deployment"
      },
      "service_id": "aws_nat_gateway"
    },
    {
      "id": "aws_route_table.simple_app",
      "type": "network_boundary",
      "label": "Private application · NAT A",
      "capability": {
        "design_local_route": "10.20.0.0/16 -> local (AWS-created)"
      },
      "service_id": "aws_route_table",
      "routes": [
        {
          "destination_cidr": "0.0.0.0/0",
          "target": "aws_nat_gateway.simple_a"
        }
      ]
    },
    {
      "id": "aws_route_table.simple_data",
      "type": "network_boundary",
      "label": "Database · local routes only",
      "capability": {
        "design_local_route": "10.20.0.0/16 -> local (AWS-created)"
      },
      "service_id": "aws_route_table"
    },
    {
      "id": "aws_route53_record.simple",
      "type": "dns",
      "label": "Public application DNS",
      "capability": {
        "name": "app.example.com",
        "type": "A",
        "design_alias": "aws_lb.simple",
        "design_dns_client": "internet"
      },
      "service_id": "aws_route53_record"
    },
    {
      "id": "aws_lb.simple",
      "type": "load_balancer",
      "label": "HTTPS entry point",
      "capability": {
        "internal": "false",
        "deletion_protection": "true",
        "design_listener": "HTTPS 443; attach an ACM certificate for app.example.com"
      },
      "service_id": "aws_lb",
      "sizing": {
        "load_balancer_type": "application",
        "region": "eu-west-1"
      }
    },
    {
      "id": "aws_instance.simple",
      "type": "compute",
      "label": "Private application (EC2)",
      "capability": {
        "associate_public_ip_address": "false",
        "metadata_http_tokens": "required",
        "design_administration": "Systems Manager through outbound HTTPS; no inbound SSH"
      },
      "service_id": "aws_instance",
      "sizing": {
        "region": "eu-west-1",
        "count": "1"
      }
    },
    {
      "id": "aws_db_subnet_group.simple",
      "type": "network_boundary",
      "label": "Isolated database subnets",
      "capability": {},
      "service_id": "aws_db_subnet_group"
    },
    {
      "id": "aws_db_instance.simple",
      "type": "managed_database",
      "label": "Private PostgreSQL database",
      "capability": {
        "storage_encrypted": "true",
        "multi_az": "false",
        "publicly_accessible": "false",
        "deletion_protection": "true",
        "backup_retention_period_days": "7",
        "design_engine": "PostgreSQL; port 5432"
      },
      "service_id": "aws_db_instance",
      "sizing": {
        "region": "eu-west-1"
      }
    },
    {
      "id": "aws_security_group.simple_entry",
      "type": "network_boundary",
      "label": "Entry · HTTPS from internet",
      "capability": {},
      "service_id": "aws_security_group",
      "security_group_rules": [
        {
          "direction": "ingress",
          "protocol": "tcp",
          "from_port": 443,
          "to_port": 443,
          "cidr_blocks": [
            "0.0.0.0/0"
          ]
        },
        {
          "direction": "egress",
          "protocol": "tcp",
          "from_port": 8080,
          "to_port": 8080,
          "cidr_blocks": [
            "10.20.10.0/24"
          ]
        }
      ]
    },
    {
      "id": "aws_security_group.simple_app",
      "type": "network_boundary",
      "label": "App · only from entry",
      "capability": {},
      "service_id": "aws_security_group",
      "security_group_rules": [
        {
          "direction": "ingress",
          "protocol": "tcp",
          "from_port": 8080,
          "to_port": 8080,
          "source_security_group": "aws_security_group.simple_entry"
        },
        {
          "direction": "egress",
          "protocol": "tcp",
          "from_port": 5432,
          "to_port": 5432,
          "cidr_blocks": [
            "10.20.20.0/23"
          ]
        },
        {
          "direction": "egress",
          "protocol": "tcp",
          "from_port": 443,
          "to_port": 443,
          "cidr_blocks": [
            "0.0.0.0/0"
          ]
        }
      ]
    },
    {
      "id": "aws_security_group.simple_data",
      "type": "network_boundary",
      "label": "Database · only from app",
      "capability": {},
      "service_id": "aws_security_group",
      "security_group_rules": [
        {
          "direction": "ingress",
          "protocol": "tcp",
          "from_port": 5432,
          "to_port": 5432,
          "source_security_group": "aws_security_group.simple_app"
        }
      ]
    },
    {
      "id": "aws_iam_role.simple_app",
      "type": "identity",
      "label": "EC2 application role",
      "capability": {
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"ec2.amazonaws.com\"},\"Action\":\"sts:AssumeRole\"}]}",
        "design_permissions": "Attach only the workload-specific permissions required at deployment; no wildcard policy supplied."
      },
      "service_id": "aws_iam_role"
    },
    {
      "id": "aws_network_acl.simple_baseline",
      "type": "network_boundary",
      "label": "simple baseline subnet rules",
      "capability": {},
      "service_id": "aws_network_acl",
      "nacl_rules": [
        {
          "number": 100,
          "direction": "ingress",
          "protocol": "-1",
          "from_port": 0,
          "to_port": 0,
          "cidr_block": "0.0.0.0/0",
          "action": "allow"
        },
        {
          "number": 100,
          "direction": "egress",
          "protocol": "-1",
          "from_port": 0,
          "to_port": 0,
          "cidr_block": "0.0.0.0/0",
          "action": "allow"
        }
      ]
    }
