{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CanvasEdge": {
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "type",
        "from",
        "to"
      ]
    },
    "CanvasNode": {
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object",
          "description": "Free-form capability key/value pairs entered via the canvas UI. Untyped in this contract version — see CanvasNode's own doc comment."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "type",
        "label",
        "capability"
      ]
    }
  },
  "properties": {
    "nodes": {
      "items": {
        "$ref": "#/$defs/CanvasNode"
      },
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/CanvasEdge"
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "nodes",
    "edges"
  ],
  "x-changelog": "contracts/CHANGELOG.md",
  "x-schema-version": "1.0.0"
}
