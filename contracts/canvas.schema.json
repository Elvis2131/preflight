{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CanvasEdge": {
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "type",
        "from",
        "to"
      ]
    },
    "CanvasNode": {
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object",
          "description": "Free-form capability key/value pairs entered via the canvas UI. Untyped in this contract version — see CanvasNode's own doc comment."
        },
        "sizing": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object",
          "description": "Free-form sizing key/value pairs entered via the canvas UI Design inspector (PC-110). Keys are core.Sizing's own canonical field names. Blank/absent means unknown"
        },
        "service_id": {
          "type": "string",
          "description": "The real provider resource_type this node represents (e.g. aws_db_instance) — the same key providers.Registry uses for the Terraform ingest path. Absent or unresolvable leaves capability_level unresolved"
        },
        "security_group_rules": {
          "items": {
            "$ref": "#/$defs/CanvasSecurityGroupRule"
          },
          "type": "array",
          "description": "Security Group rules authored on this node (PC-137) — mirrors ingest/securitygroups.go's own normalized rule shape. A component attaches to this security group via a depends_on edge exactly as the Terraform ingest path already represents SG attachment."
        },
        "availability_zone": {
          "type": "string",
          "description": "The Availability Zone a subnet resides in (e.g. eu-west-1a) — one value"
        },
        "cidr_block": {
          "type": "string",
          "description": "IPv4 CIDR block of a VPC or subnet. Absent means unknown."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "type",
        "label",
        "capability"
      ]
    },
    "CanvasSecurityGroupRule": {
      "properties": {
        "direction": {
          "type": "string",
          "enum": [
            "ingress",
            "egress"
          ]
        },
        "protocol": {
          "type": "string",
          "description": "tcp / udp / icmp / -1 (AWS's own all-protocols sentinel)."
        },
        "from_port": {
          "type": "integer"
        },
        "to_port": {
          "type": "integer"
        },
        "cidr_blocks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source_security_group": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "direction",
        "protocol"
      ]
    }
  },
  "properties": {
    "nodes": {
      "items": {
        "$ref": "#/$defs/CanvasNode"
      },
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/CanvasEdge"
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "nodes",
    "edges"
  ],
  "x-changelog": "contracts/CHANGELOG.md",
  "x-schema-version": "1.4.0"
}
