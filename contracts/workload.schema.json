{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DeclaredJourney": {
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "minItems": 2
        },
        "protocol": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "criticality": {
          "type": "string",
          "description": "e.g. tier1 — the same workload-declared vocabulary as Workload.Criticality"
        },
        "peak_rps": {
          "type": "number"
        },
        "steady_rps": {
          "type": "number"
        },
        "avg_request_bytes": {
          "type": "number"
        },
        "avg_response_bytes": {
          "type": "number"
        },
        "iam_check": {
          "$ref": "#/$defs/JourneyIAMCheck"
        },
        "fallback": {
          "$ref": "#/$defs/JourneyFallback"
        },
        "hop_ports": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object",
          "description": "Optional per-hop port overrides keyed by the hop's destination (the exact Path element). A hop with no entry uses the journey's port."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name",
        "path",
        "protocol",
        "port",
        "criticality"
      ]
    },
    "JourneyFallback": {
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "What the degraded mode is"
        },
        "path": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "minItems": 2
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "description",
        "path"
      ]
    },
    "JourneyIAMCheck": {
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "resource_arn": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "principal_id",
        "action"
      ]
    },
    "Requirement": {
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "value": true,
        "priority": {
          "type": "string",
          "enum": [
            "hard",
            "preference"
          ]
        },
        "rank": {
          "type": "integer",
          "description": "Required when Priority is preference; must be absent when Priority is hard."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "value",
        "priority"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "criticality": {
      "type": "string",
      "description": "e.g. tier1 — the golden reference architecture's own vocabulary (CLAUDE.md §14)"
    },
    "data_classification": {
      "type": "string"
    },
    "regions": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "minItems": 1
    },
    "compliance_profiles": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "description": "e.g. PCI — may be empty; not every workload has a stated compliance profile."
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "type": "array"
    },
    "capacity": {
      "additionalProperties": {
        "type": "number"
      },
      "type": "object"
    },
    "journeys": {
      "items": {
        "$ref": "#/$defs/DeclaredJourney"
      },
      "type": "array"
    },
    "service_time_ms": {
      "additionalProperties": {
        "type": "number"
      },
      "type": "object"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "criticality",
    "data_classification",
    "regions",
    "compliance_profiles",
    "requirements"
  ],
  "x-changelog": "contracts/CHANGELOG.md",
  "x-schema-version": "1.5.0"
}
