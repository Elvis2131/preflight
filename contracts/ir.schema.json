{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CapabilityModel": {
      "properties": {
        "replication_mode": {
          "type": "string",
          "description": "e.g. sync or async"
        },
        "failover_mechanism": {
          "type": "string"
        },
        "failover_time_class": {
          "type": "string",
          "description": "A documented class (e.g. seconds/minutes)"
        },
        "backup_semantics": {
          "type": "string"
        },
        "encryption_mechanism": {
          "type": "string"
        },
        "key_ownership": {
          "type": "string",
          "description": "e.g. aws-managed or customer-managed (CMK)"
        },
        "multi_az_implementation": {
          "type": "string"
        },
        "maintenance_behaviour": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Edge": {
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "description": "Node ID."
        },
        "to": {
          "type": "string",
          "description": "Node ID."
        },
        "resolution": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "raw_attributes": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "type",
        "from",
        "to",
        "resolution",
        "provenance"
      ]
    },
    "Node": {
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "resolution": {
          "type": "string",
          "enum": [
            "known",
            "inferred",
            "unresolved"
          ]
        },
        "capability": {
          "$ref": "#/$defs/CapabilityModel",
          "description": "Present only when Resolution is known or inferred enough to populate it; a node with capability entirely nil is not a claim of no capabilities"
        },
        "sizing": {
          "$ref": "#/$defs/Sizing",
          "description": "Present only when at least one sizing fact is known for this node; absent entirely means cost_unknown for every costable dimension"
        },
        "raw_attributes": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "type",
        "resolution",
        "provenance"
      ]
    },
    "Provenance": {
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "stated",
            "derived",
            "assumed",
            "llm_reasoned",
            "observed"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "description": "Required for assumed and llm_reasoned; the IR evidence citation or the overridable default's justification."
        },
        "evidence_tier": {
          "type": "string",
          "enum": [
            "functional",
            "performance",
            "resilience"
          ]
        },
        "rung": {
          "type": "integer",
          "enum": [
            1,
            2,
            3
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "source"
      ]
    },
    "Sizing": {
      "properties": {
        "instance_type": {
          "type": "string",
          "description": "e.g. an EC2 instance type (compute) — mutually relevant with TaskCPU/TaskMemory"
        },
        "task_cpu": {
          "type": "string",
          "description": "Container task vCPU allocation (container_workload) — e.g. ECS task_definition cpu."
        },
        "task_memory": {
          "type": "string",
          "description": "Container task memory allocation (container_workload) — e.g. ECS task_definition memory."
        },
        "count": {
          "type": "integer",
          "description": "A declared instance/task/node count — a SIZING fact only"
        },
        "instance_class": {
          "type": "string",
          "description": "Managed database instance class (managed_database) — e.g. RDS instance_class. Multi-AZ is NOT duplicated here — see CapabilityModel.MultiAZImplementation."
        },
        "allocated_storage_gb": {
          "type": "integer",
          "description": "Allocated storage"
        },
        "storage_type": {
          "type": "string",
          "description": "Storage type (managed_database) — e.g. RDS storage_type (gp3"
        },
        "cache_node_type": {
          "type": "string",
          "description": "Cache node type (cache) — e.g. ElastiCache node_type."
        },
        "load_balancer_type": {
          "type": "string",
          "description": "Load balancer type (load_balancer) — ALB or NLB. Usage-based charges (data processed) are not_assessable until traffic inputs exist (PC-124)."
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Contract version of this schema itself — see CHANGELOG.md. Not the same thing as VersionNumber below"
    },
    "version_number": {
      "type": "integer",
      "minimum": 1
    },
    "version_hash": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "version_number",
    "version_hash",
    "nodes",
    "edges"
  ],
  "x-changelog": "contracts/CHANGELOG.md",
  "x-schema-version": "1.2.0"
}
