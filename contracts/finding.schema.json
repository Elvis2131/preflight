{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AssessmentEnvelope": {
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "assessed",
            "not_assessable"
          ]
        },
        "value": {
          "description": "Present iff state is assessed."
        },
        "reason": {
          "type": "string",
          "description": "Present iff state is not_assessable — I4: incompleteness always carries a stated reason"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "state",
        "provenance"
      ]
    },
    "EvidenceRef": {
      "properties": {
        "node_id": {
          "type": "string",
          "description": "Set when this evidence points at an IR node."
        },
        "edge_id": {
          "type": "string",
          "description": "Set when this evidence points at an IR edge."
        },
        "experiment_id": {
          "type": "string",
          "description": "Set when this evidence is a validate/ Rung 1/3 run"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "attribute": {
          "type": "string",
          "description": "The specific attribute this evidence concerns"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "description"
      ]
    },
    "FailureMode": {
      "properties": {
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "affected_components": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "minItems": 1
        },
        "blast_radius": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "detection": {
          "type": "string",
          "enum": [
            "modeled",
            "declared",
            "unknown",
            "observed"
          ]
        },
        "existing_mitigation": {
          "type": "string"
        },
        "gap": {
          "type": "string"
        },
        "impact": {
          "$ref": "#/$defs/AssessmentEnvelope"
        },
        "likelihood": {
          "$ref": "#/$defs/AssessmentEnvelope",
          "description": "Per CLAUDE.md §10: assumed or unknown"
        },
        "detectability": {
          "$ref": "#/$defs/AssessmentEnvelope",
          "description": "Derived from Detection."
        },
        "recoverability": {
          "$ref": "#/$defs/Recoverability"
        },
        "recommendation": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "trigger",
        "affected_components",
        "detection",
        "impact",
        "likelihood",
        "detectability",
        "recoverability"
      ]
    },
    "Provenance": {
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "stated",
            "derived",
            "assumed",
            "llm_reasoned",
            "observed"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "description": "Required for assumed and llm_reasoned; the IR evidence citation or the overridable default's justification."
        },
        "evidence_tier": {
          "type": "string",
          "enum": [
            "functional",
            "performance",
            "resilience"
          ]
        },
        "rung": {
          "type": "integer",
          "enum": [
            1,
            2,
            3
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "source"
      ]
    },
    "Recoverability": {
      "properties": {
        "failover_path_exists": {
          "$ref": "#/$defs/AssessmentEnvelope"
        },
        "rpo_feasible": {
          "$ref": "#/$defs/AssessmentEnvelope"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "failover_path_exists",
        "rpo_feasible"
      ]
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "dimensions": {
      "$ref": "#/$defs/FailureMode"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "type": "array",
      "minItems": 1,
      "description": "A finding must always cite at least one piece of evidence — this project's stated principle is compliance WITH evidence"
    },
    "outcome": {
      "$ref": "#/$defs/AssessmentEnvelope"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "title",
    "dimensions",
    "evidence",
    "outcome"
  ],
  "x-changelog": "contracts/CHANGELOG.md",
  "x-schema-version": "1.2.0"
}
